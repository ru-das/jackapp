{
  "expo": {
    "name": "JackApp",
    "slug": "jackapp",
    "scheme": "jackapp",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "app.jackapp",
      "adaptiveIcon": {
        "backgroundColor": "#CFE8C8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "llama.rn",
        {
          "forceCxx20": true,
          "enableOpenCLAndHexagon": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "JackApp needs the camera to read photos you ask it to analyse."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "extraProguardRules": "-keep class com.rnllama.** { *; }"
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "295f9a3d-7c94-4240-be47-f665ec0d53a8"
      }
    },
    "owner": "ru-das",
    "experiments": {
      "baseUrl": "/jackapp"
    }
  }
}
